Options -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch "^(settings\.php|settings\.local\.php|database\.php|cashapp_credentials\.php)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "^(settings\.php|settings\.local\.php|database\.php|cashapp_credentials\.php)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>