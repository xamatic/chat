# --- IDEs and System Files ---
.vscode/
.idea/
.github/
.ftpquota
error_log
compare_results.txt

# --- Dependencies ---
node_modules/

# --- Environment & Configuration (Preserved on server) ---
# We ignore these locally because the script indicates they are 
# server-specific or contain sensitive credentials.
system/database.php
system/settings.php

# --- User-Generated Content / Media ---
# These paths are excluded in your rsync to prevent overwriting 
# uploads with empty local folders.
avatar/
cover/
upload/
music/
room_icon/
gift/
theme_public/
css/themes/
goofy/
*files.zip*
updates files/update*

# --- Deployment Artifacts ---
