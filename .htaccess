Options -Indexes
RewriteEngine on
IndexIgnore *
RewriteRule ^room([0-9]+)$ index.php?room=$1 [QSA] 

Options -Indexes
IndexIgnore *
RewriteEngine on

# ============================================
# URL REWRITING (your original rule)
# ============================================
RewriteRule ^room([0-9]+)$ index.php?room=$1 [QSA]

# ============================================
# BLOCK BAD BOTS (stops them eating bandwidth)
# ============================================
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP_USER_AGENT} (AhrefsBot|SemrushBot|MJ12bot|DotBot|BLEXBot|DataForSeoBot) [NC]
    RewriteRule .* - [F,L]
</IfModule>

# ============================================
# GZIP COMPRESSION (cuts transfer size ~70%)
# ============================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE font/woff
</IfModule>

# ============================================
# BROWSER CACHING
# ============================================
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML - short cache (dynamic content)
    ExpiresByType text/html                    "access plus 1 hour"

    # CSS & JavaScript
    ExpiresByType text/css                     "access plus 1 year"
    ExpiresByType application/javascript       "access plus 1 year"
    ExpiresByType text/javascript              "access plus 1 year"

    # Images
    ExpiresByType image/jpeg                   "access plus 1 year"
    ExpiresByType image/png                    "access plus 1 year"
    ExpiresByType image/gif                    "access plus 1 year"
    ExpiresByType image/webp                   "access plus 1 year"
    ExpiresByType image/svg+xml                "access plus 1 year"
    ExpiresByType image/x-icon                 "access plus 1 year"

    # Fonts
    ExpiresByType font/woff2                   "access plus 1 year"
    ExpiresByType font/woff                    "access plus 1 year"
    ExpiresByType application/font-woff2       "access plus 1 year"
    ExpiresByType application/font-woff        "access plus 1 year"

    # Audio (your sound files had NO cache - big fix!)
    ExpiresByType audio/mpeg                   "access plus 1 month"
    ExpiresByType audio/ogg                    "access plus 1 month"
    ExpiresByType audio/wav                    "access plus 1 month"

    # Default fallback
    ExpiresDefault                             "access plus 1 month"
</IfModule>

# Cache-Control headers
<IfModule mod_headers.c>
    # Long cache for static assets
    <FilesMatch "\.(css|js|woff|woff2|ttf|eot|svg|png|jpg|jpeg|gif|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Audio files - 1 month
    <FilesMatch "\.(mp3|ogg|wav)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # PHP pages - never cache
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# ============================================
# SECURITY HEADERS
# ============================================
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ============================================
# BLOCK DIRECT ACCESS TO SENSITIVE FILES
# ============================================
<FilesMatch "\.(sql|log|env|ini|sh|bak)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ============================================
# LITESPEED CACHE
# ============================================
<IfModule LiteSpeed>
    CacheLookup on
</IfModule>

# ============================================
# KEEP ALIVE
# ============================================
<IfModule mod_headers.c>
    Header set Connection keep-alive
</IfModule>
